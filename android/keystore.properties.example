# ==============================================================================
# Android Release Signing Configuration Template
# ==============================================================================
# Copy this file to 'keystore.properties' in this directory (/android/keystore.properties).
# DO NOT COMMIT 'keystore.properties' OR ANY '.jks' / '.keystore' FILES TO GIT!
# Keep your keystore files backed up in a secure, encrypted offline location.
# ==============================================================================

# Amazon Appstore Release Signing
AMAZON_KEYSTORE_FILE=../keystores/amazon-release.jks
AMAZON_KEYSTORE_PASSWORD=your_secure_amazon_keystore_password
AMAZON_KEY_ALIAS=arrowmaster-amazon
AMAZON_KEY_PASSWORD=your_secure_amazon_key_password

# Google Play Console Upload Signing (Play App Signing)
GOOGLE_KEYSTORE_FILE=../keystores/google-upload.jks
GOOGLE_KEYSTORE_PASSWORD=your_secure_google_keystore_password
GOOGLE_KEY_ALIAS=arrowmaster-upload
GOOGLE_KEY_PASSWORD=your_secure_google_key_password
